# Server-only secrets: use .env.local for local values; never use VITE_ for DATABASE_URL.
DATABASE_URL=
# Set true in Vercel Production only, after applying docs/analytics-schema.sql.
GAME_ANALYTICS_ENABLED=false
# Exact canonical URL, no trailing slash (e.g. https://velocidice.vercel.app).
GAME_ANALYTICS_ORIGIN=
